# Google Sheets endpoint for live product data
#
# OPTION 1 (Recommended): Google Sheets Published JSON
# 1. Open your Google Sheet in the browser
# 2. File > Share > Publish to web > select your sheet tab > JSON
# 3. Copy the SHEET_ID from your Google Sheet URL: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit
# 4. Set the URL to: https://docs.google.com/spreadsheets/d/{SHEET_ID}/gviz/tq?tqx=out:json
#
# OPTION 2: SheetBest / SheetDB (if you have an active subscription)
# VITE_SHEETS_API_URL=https://api.sheetbest.com/sheets/YOUR-SHEET-ID
#
# Expected columns: id, productName, slug, category, subCategory, description,
# fullDescription, price, imageUrl, stockStatus, featured, origin, packaging,
# moq, applications, descriptionAttributes, productDetails, nutritionalValues,
# qualityInfo, shippingInfo
#
# applications — semicolon-separated list (e.g. "Rope manufacturing; Twine production")
# descriptionAttributes — semicolon-separated key:value pairs (e.g. "Country of Origin: Kenya")
# productDetails — semicolon-separated key:value pairs (e.g. "Ingredients: Crude sunflower oil")
# nutritionalValues — semicolon-separated key:value pairs (e.g. "Energy (kJ): 3760 kJ")
#
# If unset, the app falls back to the static product data in src/data/products.ts
VITE_SHEETS_API_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/gviz/tq?tqx=out:json
